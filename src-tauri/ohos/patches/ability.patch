index 0000000..b8c9d01
--- /dev/null
+++ b/native_ability/src/main/ets/runtime/ApplicationWindows.ets
@@ -0,0 +1,228 @@
+import common from "@ohos.app.ability.common";
+import Want from "@ohos.app.ability.Want";
+import window from "@ohos.window";
+import { BridgeHostRegistry } from "../bridge/BridgeHost";
+import { WindowSurface, WindowSurfaceRegistry } from "../components/WindowSurface";
+
+export interface ApplicationWindowHost {
+  windowId: number;
+  nonce: string;
+  context: common.UIAbilityContext;
+  stage: window.WindowStage;
+  win: window.Window;
+  surface: WindowSurface;
+}
+
+interface PendingWindow {
+  nonce: string;
+  resolve: (host: ApplicationWindowHost) => void;
+  reject: (error: Error) => void;
+}
+
+/** One application owns its live UIAbility instances; no window is another window's child. */
+export class ApplicationWindows {
+  private static readonly applications: Map<string, ApplicationWindows> = new Map();
+  private readonly hosts: Map<number, ApplicationWindowHost> = new Map();
+  private readonly pending: Map<number, PendingWindow> = new Map();
+  private firstStage?: Promise<void>;
+  private closedListener?: (id: number) => void;
+  private disposed: boolean = false;
+  private nextNonce: number = 1;
+
+  private readonly sessionId: string;
+  private readonly moduleName: string;
+  private readonly abilityName: string;
+  private readonly onEmpty: () => Promise<void>;
+  private readonly onFirstStage: (stage: window.WindowStage) => Promise<void>;
+
+  constructor(sessionId: string, moduleName: string, abilityName: string,
+    onEmpty: () => Promise<void>, onFirstStage: (stage: window.WindowStage) => Promise<void>) {
+    this.sessionId = sessionId;
+    this.moduleName = moduleName;
+    this.abilityName = abilityName;
+    this.onEmpty = onEmpty;
+    this.onFirstStage = onFirstStage;
+    ApplicationWindows.applications.set(sessionId, this);
+  }
+
+  static find(sessionId: string): ApplicationWindows | undefined {
+    return ApplicationWindows.applications.get(sessionId);
+  }
+
+  onClosed(listener: (id: number) => void): void { this.closedListener = listener; }
+
+  get(id: number): ApplicationWindowHost {
+    const host = this.hosts.get(id);
+    if (host === undefined) { throw new Error(`Unknown application window ${id}`); }
+    return host;
+  }
+
+  async focus(id: number, requester?: common.UIAbilityContext): Promise<void> {
+    const host = this.get(id);
+    const want: Want = {
+      bundleName: host.context.applicationInfo.name,
+      moduleName: host.context.abilityInfo.moduleName,
+      abilityName: host.context.abilityInfo.name,
+    };
+    if (id !== 0) {
+      want.parameters = { nativeApplicationSession: this.sessionId, nativeWindowId: id, nativeWindowNonce: host.nonce };
+    }
+    // Entry is singleton; peers are specified by their creation nonce. startAbility
+    // foregrounds that exact UIAbility, including minimized/background main windows.
+    await (requester ?? host.context).startAbility(want);
+    this.assertAttached(host);
+  }
+
+  async focusExisting(requester: common.UIAbilityContext): Promise<void> {
+    let failure = "No live application window";
+    for (const host of this.hosts.values()) {
+      try {
+        await this.focus(host.windowId, requester);
+        return;
+      } catch (error) {
+        // A native instance may already be awaiting its destroy callback. Try peers,
+        // but do not report a successful relaunch if every activation failed.
+        failure = `Unable to activate window ${host.windowId}: ${String(error)}`;
+      }
+    }
+    throw new Error(failure);
+  }
+
+  async open(id: number, onCancel: (listener: () => void) => () => void): Promise<ApplicationWindowHost> {
+    if (this.disposed || this.hosts.has(id) || this.pending.has(id)) { throw new Error("Invalid application window creation"); }
+    let issuer: ApplicationWindowHost | undefined;
+    for (const host of this.hosts.values()) {
+      try {
+        const focused = host.win.isFocused();
+        if (issuer === undefined || focused) { issuer = host; }
+        if (focused) { break; }
+      } catch { continue; }
+    }
+    if (issuer === undefined) { throw new Error("No live UIAbility can start a window"); }
+    const nonce = `${this.sessionId}:${this.nextNonce++}`;
+    let unsubscribe: () => void = (): void => {};
+    const result = new Promise<ApplicationWindowHost>((resolve, reject): void => {
+      this.pending.set(id, { nonce, resolve, reject });
+      unsubscribe = onCancel((): void => this.cancel(id, nonce, new Error("Window creation was cancelled")));
+    });
+    try {
+      if (!this.pending.has(id)) { return await result; }
+      // Keep the independent instance in the same application process. The private specified
+      // Ability accepts only a currently reserved nonce; stale OS callbacks cannot resurrect it.
+      void issuer.context.startAbility({
+        bundleName: issuer.context.applicationInfo.name,
+        moduleName: issuer.context.abilityInfo.moduleName,
+        abilityName: this.abilityName,
+        parameters: { nativeApplicationSession: this.sessionId, nativeWindowId: id, nativeWindowNonce: nonce },
+      }).catch((error: Error): void => this.cancel(id, nonce, new Error(String(error))));
+      return await result;
+    } finally { unsubscribe(); }
+  }
+
+  private cancel(id: number, nonce: string, error: Error): void {
+    const pending = this.pending.get(id);
+    if (pending?.nonce !== nonce) { return; }
+    this.pending.delete(id);
+    pending.reject(error);
+    WindowSurfaceRegistry.get(this.sessionId, id).dispose(error);
+    if (this.hosts.get(id)?.nonce === nonce) {
+      void this.close(id).catch((failure: Error): void => console.error(`Cancelled window cleanup failed: ${String(failure)}`));
+    } else { void this.finishIfEmpty(); }
+  }
+
+  async attach(id: number, nonce: string, context: common.UIAbilityContext, stage: window.WindowStage): Promise<void> {
+    if (this.disposed || this.hosts.has(id) || (id !== 0 && this.pending.get(id)?.nonce !== nonce)) {
+      throw new Error("Unknown or cancelled application window reservation");
+    }
+    const surface = WindowSurfaceRegistry.get(this.sessionId, id);
+    const host: ApplicationWindowHost = { windowId: id, nonce, context, stage, win: stage.getMainWindowSync(), surface };
+    this.hosts.set(id, host);
+    try {
+      if (this.firstStage === undefined) { this.firstStage = this.onFirstStage(stage); }
+      await this.firstStage;
+      this.assertAttached(host);
+      const storage = new LocalStorage();
+      storage.setOrCreate("nativeWindowSurface", WindowSurfaceRegistry.key(this.sessionId, id));
+      await stage.loadContentByName("NativeAbilityWindow", storage);
+      this.assertAttached(host);
+      // Route mounting and window configuration are separate barriers. WebViews still wait
+      // for ManagedWindows.markReady after title, sizing and visibility have all succeeded.
+      await surface.waitForMount((_listener: () => void): (() => void) => (): void => {});
+      this.assertAttached(host);
+      await BridgeHostRegistry.attachApplicationWindow(this.sessionId, this.moduleName, id,
+        context, stage, surface.getUIContext(), surface.getRootFrameNode());
+      this.assertAttached(host);
+      const pending = this.pending.get(id);
+      if (pending?.nonce === nonce) {
+        this.pending.delete(id);
+        pending.resolve(host);
+      }
+    } catch (error) {
+      this.cancel(id, nonce, new Error(String(error)));
+      await this.detach(id, nonce);
+      throw new Error(String(error));
+    }
+  }
+
+  private assertAttached(host: ApplicationWindowHost): void {
+    if (this.disposed || this.hosts.get(host.windowId) !== host || host.surface.isClosed()) {
+      throw new Error("Application window attachment was cancelled");
+    }
+  }
+
+  async close(id: number): Promise<void> {
+    const host = this.get(id);
+    await host.context.terminateSelf();
+    await this.detach(id, host.nonce);
+  }
+
+  async detach(id: number, nonce: string): Promise<void> {
+    const host = this.hosts.get(id);
+    if (host === undefined) {
+      const pending = this.pending.get(id);
+      if (pending?.nonce !== nonce) { return; }
+      this.pending.delete(id);
+      const error = new Error("UIAbility closed before window attachment");
+      pending.reject(error);
+      WindowSurfaceRegistry.get(this.sessionId, id).dispose(error);
+      await this.finishIfEmpty();
+      return;
+    }
+    if (host.nonce !== nonce) { return; }
+    this.hosts.delete(id);
+    // Notify the logical owner while the bridge is live, before final application shutdown.
+    this.closedListener?.(id);
+    BridgeHostRegistry.detachApplicationWindow(this.sessionId, this.moduleName, id);
+    // Preserve failed surfaces until the logical window is explicitly destroyed.
+    // A late WebView create must receive the same failure, never a fresh unready surface.
+    host.surface.dispose();
+    const pending = this.pending.get(id);
+    if (pending?.nonce === nonce) {
+      this.pending.delete(id);
+      pending.reject(new Error("UIAbility closed before window attachment"));
+    }
+    await this.finishIfEmpty();
+  }
+
+  private async finishIfEmpty(): Promise<void> {
+    if (!this.disposed && this.hosts.size === 0 && this.pending.size === 0) { await this.onEmpty(); }
+  }
+
+  async dispose(): Promise<void> {
+    if (this.disposed) { return; }
+    this.disposed = true;
+    ApplicationWindows.applications.delete(this.sessionId);
+    const pending = Array.from(this.pending.values());
+    this.pending.clear();
+    for (const item of pending) { item.reject(new Error("Application is shutting down")); }
+    const hosts = Array.from(this.hosts.values());
+    this.hosts.clear();
+    this.closedListener = undefined;
+    WindowSurfaceRegistry.clear(this.sessionId);
+    for (const host of hosts) {
+      BridgeHostRegistry.detachApplicationWindow(this.sessionId, this.moduleName, host.windowId);
+      try { await host.context.terminateSelf(); }
+      catch (error) { console.error(`UIAbility shutdown failed: ${String(error)}`); }
+    }
+  }
+}
