+import { AbilityConstant, Configuration, UIAbility, Want } from "@kit.AbilityKit";
+import common from "@ohos.app.ability.common";
+import window from "@ohos.window";
+import { NativeApplication } from "./NativeApplication";
+import { AbilityInitContext, BridgePluginFactory } from "./type";
+
+const STATE_KEY = "ohos.rs.ability.application.state";
+
+/** A real platform UIAbility for one independent application WindowStage. */
+export class NativeApplicationAbility extends UIAbility {
+  public moduleName: string = "";
+  public bridgePlugins: BridgePluginFactory[] = [];
+  public peerAbilityName: string = "";
+
+  private application?: NativeApplication;
+  private creating: Promise<NativeApplication | undefined> = Promise.resolve(undefined);
+  private stageWork: Promise<void> = Promise.resolve();
+  private detaching?: Promise<void>;
+  private windowId: number = 0;
+  private nonce: string = "initial";
+  private initialOwner: boolean = false;
+  private stageStarted: boolean = false;
+  private closing: boolean = false;
+
+  protected createInitContext(moduleName: string): AbilityInitContext {
+    const context = this.context as common.UIAbilityContext;
+    return {
+      basePath: context.filesDir,
+      prefPath: context.filesDir,
+      preferredLocales: context.config?.language ?? "",
+      moduleName,
+      resourceManager: context.resourceManager,
+    };
+  }
+
+  onCreate(want: Want, _launchParam: AbilityConstant.LaunchParam): void {
+    this.creating = this.resolveApplication(want).catch(async (error: Error): Promise<undefined> => {
+      await this.fail("application-create", error);
+      return undefined;
+    });
+  }
+
+  private async resolveApplication(want: Want): Promise<NativeApplication | undefined> {
+    const requestedSession = want.parameters?.["nativeApplicationSession"];
+    if (requestedSession !== undefined) {
+      const id = want.parameters?.["nativeWindowId"];
+      const nonce = want.parameters?.["nativeWindowNonce"];
+      if (typeof requestedSession !== "string" || typeof id !== "number" ||
+          !Number.isSafeInteger(id) || id <= 0 || typeof nonce !== "string" || !nonce) {
+        throw new Error("Invalid native application window identity");
+      }
+      this.windowId = id;
+      this.nonce = nonce;
+      this.application = await NativeApplication.find(requestedSession, this.moduleName);
+      return this.application;
+    }
+    const restoring = want.parameters?.["ohos.ability.params.abilityRecoveryRestart"] === true;
+    const state = restoring ? want.parameters?.[STATE_KEY]?.toString() ?? "" : "";
+    const lease = await NativeApplication.acquire(this.context as common.UIAbilityContext,
+      this.moduleName, this.bridgePlugins, this.createInitContext(this.moduleName), this.peerAbilityName, state);
+    if (!lease.initialOwner) {
+      // Opening Entry again while a peer survives focuses that application. Its
+      // destroyed logical window 0 must never be recreated or module.init rerun.
+      await lease.application.windows.focusExisting(this.context as common.UIAbilityContext);
+      await this.context.terminateSelf();
+      return undefined;
+    }
+    this.initialOwner = true;
+    this.application = lease.application;
+    return this.application;
+  }
+
+  onWindowStageCreate(stage: window.WindowStage): void {
+    this.stageWork = this.stageWork.then(async (): Promise<void> => {
+      const application = await this.creating;
+      if (application === undefined || this.closing) return;
+      this.stageStarted = true;
+      await application.windows.attach(this.windowId, this.nonce, this.context as common.UIAbilityContext, stage);
+    }).catch(async (error: Error): Promise<void> => {
+      try {
+        await this.detach();
+      } catch (cleanupError) {
+        console.error(`[NativeApplicationAbility] failed stage cleanup: ${String(cleanupError)}`);
+      }
+      await this.fail("window-stage-create", error);
+    });
+  }
+
+  onWindowStageDestroy(): void {
+    this.closing = true;
+    // Detach must interrupt a pending mount; waiting for stageWork here would
+    // deadlock when the platform destroys a window before its surface mounts.
+    void this.detach()
+      .catch((error: Error): void => { console.error(`[NativeApplicationAbility] stage teardown failed: ${String(error)}`); });
+  }
+
+  onDestroy(): Promise<void> {
+    this.closing = true;
+    const detached = this.detach();
+    return Promise.allSettled([this.stageWork, detached]).then((results): void => {
+      for (const result of results) {
+        if (result.status === "rejected") throw new Error(`Native Ability teardown failed: ${String(result.reason)}`);
+      }
+    });
+  }
+
+  private detach(): Promise<void> {
+    if (this.detaching !== undefined) return this.detaching;
+    this.detaching = this.creating.then(async (application): Promise<void> => {
+      if (application === undefined) return;
