+import common from "@ohos.app.ability.common";
+import window from "@ohos.window";
+import { BridgeHostRegistry } from "../bridge/BridgeHost";
+import { NativeModuleLoader } from "../runtime/NativeModuleLoader";
+import { ApplicationWindows } from "../runtime/ApplicationWindows";
+import {
+  AbilityInitContext, ApplicationLifecycle, BridgeBindings,
+  BridgeAbilityCreateLifecyclePayload, BridgeEmptyLifecyclePayload,
+  BridgeLifecycleEvent, BridgeMemoryLevelLifecyclePayload, BridgePluginFactory, Module,
+} from "./type";
+
+export interface NativeApplicationLease {
+  application: NativeApplication;
+  initialOwner: boolean;
+}
+
+/** One native application per process; UIAbility instances own only its windows. */
+export class NativeApplication {
+  private static readonly modules = new Map<string, Promise<NativeApplication>>();
+  private static readonly sessions = new Map<string, Promise<NativeApplication>>();
+
+  readonly sessionId: string;
+  readonly moduleName: string;
+  readonly windows: ApplicationWindows;
+  private module?: Module;
+  private lifecycle?: ApplicationLifecycle;
+  private stageCreated: boolean = false;
+  private firstStage?: Promise<void>;
+  private closing?: Promise<void>;
+
+  private constructor(sessionId: string, moduleName: string, peerAbilityName: string) {
+    this.sessionId = sessionId;
+    this.moduleName = moduleName;
+    this.windows = new ApplicationWindows(sessionId, moduleName, peerAbilityName,
+      async (): Promise<void> => { await this.shutdown(); },
+      async (stage: window.WindowStage): Promise<void> => { await this.initializeStage(stage); });
+  }
+
+  static async acquire(context: common.UIAbilityContext, moduleName: string,
+    plugins: BridgePluginFactory[], initContext: AbilityInitContext,
+    peerAbilityName: string, restoredState: string): Promise<NativeApplicationLease> {
+    if (!moduleName || !peerAbilityName) throw new Error("Native application module and peer Ability names are required");
+    const existing = NativeApplication.modules.get(moduleName);
+    if (existing !== undefined) {
+      const application = await existing;
+      application.assertActive();
+      return { application, initialOwner: false };
+    }
+    // Publish the initialization promise synchronously before any SDK or import
+    // await. Concurrent entry creation must not initialize the native module twice.
+    const creating: Promise<NativeApplication> = Promise.resolve().then(async (): Promise<NativeApplication> => {
+      const sessionId = await BridgeHostRegistry.prepare([moduleName], context, plugins);
+      const application = new NativeApplication(sessionId, moduleName, peerAbilityName);
+      NativeApplication.sessions.set(sessionId, creating);
+      try {
+        await application.initialize(initContext, restoredState);
+        return application;
+      } catch (error) {
+        await application.shutdown();
+        throw new Error(`Unable to initialize native application: ${String(error)}`);
+      }
+    });
+    // Keep even a failed/closed entry: Tauri cannot be initialized twice in one
+    // process. Normal application exit creates a fresh process on the next launch.
+    NativeApplication.modules.set(moduleName, creating);
+    return { application: await creating, initialOwner: true };
+  }
+
+  static async find(sessionId: string, moduleName: string): Promise<NativeApplication> {
+    const ready = NativeApplication.sessions.get(sessionId);
+    if (ready === undefined) throw new Error("Native application session is unavailable");
+    const application = await ready;
+    if (application.moduleName !== moduleName) throw new Error("Native application module does not match");
+    application.assertActive();
+    return application;
+  }
+
+  private assertActive(): void {
+    if (this.closing !== undefined) throw new Error("Native application is closing");
+  }
+
+  private bindings(): BridgeBindings {
+    const sessionId = this.sessionId;
+    const moduleName = this.moduleName;
+    return {
+      bridgeInvoke: async (pluginId: string, action: string, requestTypeName: string,
+        responseTypeName: string, value: ESObject, timeoutMs: number): Promise<ESObject> =>
+        await BridgeHostRegistry.invokeAsync(sessionId, moduleName, pluginId, action,
+          requestTypeName, responseTypeName, value, timeoutMs),
+      bridgeInvokeSync: (pluginId: string, action: string, requestTypeName: string,
+        responseTypeName: string, value: ESObject): ESObject =>
+        BridgeHostRegistry.invokeSync(sessionId, moduleName, pluginId, action,
+          requestTypeName, responseTypeName, value),
+      bridgeDispatch: (): void => {},
+    };
+  }
+
+  private async initialize(context: AbilityInitContext, restoredState: string): Promise<void> {
+    const module = await NativeModuleLoader.load(this.moduleName, "async");
+    this.module = module;
+    const lifecycle = module.init(this.bindings(), `${this.sessionId}:${this.moduleName}`, context);
+    this.lifecycle = lifecycle;
+    BridgeHostRegistry.configurePlugins(this.sessionId, this.moduleName, lifecycle.bridgePlugins);
+    BridgeHostRegistry.attachApplicationLifecycle(this.sessionId, this.moduleName, lifecycle);
+    const syncSink = typeof module.onBridgeSyncEvent === "function"
+      ? (pluginId: string, event: string, requestTypeName: string, responseTypeName: string,
+          value: ESObject): ESObject => module.onBridgeSyncEvent!(pluginId, event, requestTypeName, responseTypeName, value)
+      : undefined;
+    const lifecycleSink = typeof module.onBridgeLifecycle === "function"
+      ? (kind: string): void => module.onBridgeLifecycle!(kind) : undefined;
+    BridgeHostRegistry.attachEventSink(this.sessionId, this.moduleName, syncSink, lifecycleSink);
+    lifecycle.windowStageEventCallback.onAbilityCreate(restoredState);
+    await BridgeHostRegistry.activateAbility(this.sessionId, this.moduleName, {
+      kind: "ability-create", payload: new BridgeAbilityCreateLifecyclePayload(restoredState),
+    });
+  }
+
+  private initializeStage(stage: window.WindowStage): Promise<void> {
+    this.assertActive();
+    if (this.firstStage === undefined) {
+      this.firstStage = Promise.resolve().then(async (): Promise<void> => {
+        await BridgeHostRegistry.setWindowStage(this.sessionId, this.moduleName, stage);
+        this.lifecycle!.windowStageEventCallback.onWindowStageCreate();
+        this.stageCreated = true;
+        await this.notify({ kind: "window-stage-create", payload: new BridgeEmptyLifecyclePayload() });
+      });
+    }
+    return this.firstStage;
+  }
+
+  private async notify(event: BridgeLifecycleEvent): Promise<void> {
+    await BridgeHostRegistry.emitLifecycle(this.sessionId, this.moduleName, event);
+  }
+
+  async configurationUpdated(config: object): Promise<void> {
+    this.assertActive();
+    this.lifecycle!.environmentCallback.onConfigurationUpdated(config);
+    await this.notify({ kind: "configuration-updated", payload: new BridgeEmptyLifecyclePayload() });
+  }
+
+  async memoryLevel(level: number): Promise<void> {
+    this.assertActive();
+    this.lifecycle!.environmentCallback.onMemoryLevel(level);
+    await this.notify({ kind: "memory-level", payload: new BridgeMemoryLevelLifecyclePayload(level) });
+  }
+
+  saveState(): string {
+    return this.lifecycle?.windowStageEventCallback.onAbilitySaveState() ?? "";
+  }
+
+  shutdown(): Promise<void> {
+    if (this.closing !== undefined) return this.closing;
+    BridgeHostRegistry.beginClosing(this.sessionId);
+    this.closing = Promise.resolve().then(async (): Promise<void> => {
+      try {
+        await this.windows.dispose();
+        if (this.stageCreated) {
+          await BridgeHostRegistry.clearWindowStage(this.sessionId, this.moduleName);
+          this.lifecycle!.windowStageEventCallback.onWindowStageDestroy();
+          this.stageCreated = false;
+        }
+        if (this.lifecycle !== undefined) {
+          await this.notify({ kind: "ability-destroy", payload: new BridgeEmptyLifecyclePayload() });
+          this.lifecycle.windowStageEventCallback.onAbilityDestroy();
+        }
+      } finally {
+        try {
+          this.module?.disposeAllRenders();
+        } finally {
+          try {
+            this.module?.disposeBridge(`${this.sessionId}:${this.moduleName}`);
+          } finally {
+            await BridgeHostRegistry.dispose(this.sessionId);
+            NativeApplication.sessions.delete(this.sessionId);
+          }
+        }
+      }
+    });
+    return this.closing;
+  }
+}
