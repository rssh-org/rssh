new file mode 100644
index 0000000..bb7b7b8
--- /dev/null
+++ b/native_ability/src/main/ets/components/WindowSurface.ets
@@ -0,0 +1,196 @@
+import { FrameNode, NodeController } from "@ohos.arkui.node";
+import { UIContext } from "@ohos.arkui.UIContext";
+
+interface SurfaceWaiter {
+  requireReady: boolean;
+  resolve: (surface: WindowSurface) => void;
+  reject: (error: Error) => void;
+}
+
+/** A window's UIContext and mount root always travel together. A sub-window never borrows
+ * the main window's context or claims its DefaultXComponent render owner. */
+export class WindowSurface {
+  private context?: UIContext;
+  private root?: FrameNode;
+  private disposed: boolean = false;
+  private ready: boolean = false;
+  private failure: Error = new Error("Window surface is closed");
+  private readonly waiters: SurfaceWaiter[] = [];
+  private readonly nodes: Map<string, FrameNode> = new Map();
+
+  isClosed(): boolean { return this.disposed; }
+
+  attach(context: UIContext, root: FrameNode): void {
+    if (this.disposed) { throw new Error("Window surface has already been disposed"); }
+    this.context = context;
+    this.root = root;
+    this.resolveReady();
+  }
+
+  markReady(): void {
+    if (this.disposed) { throw this.failure; }
+    this.ready = true;
+    this.resolveReady();
+  }
+
+  private resolveReady(): void {
+    if (this.root === undefined) { return; }
+    for (const waiter of this.waiters.slice()) {
+      if (waiter.requireReady && !this.ready) { continue; }
+      this.waiters.splice(this.waiters.indexOf(waiter), 1);
+      waiter.resolve(this);
+    }
+  }
+
+  wait(onCancel: (listener: () => void) => () => void): Promise<WindowSurface> {
+    return this.waitForAttachment(onCancel, true);
+  }
+
+  waitForMount(onCancel: (listener: () => void) => () => void): Promise<WindowSurface> {
+    return this.waitForAttachment(onCancel, false);
+  }
+
+  private waitForAttachment(onCancel: (listener: () => void) => () => void, requireReady: boolean): Promise<WindowSurface> {
+    if (this.disposed) { return Promise.reject(this.failure); }
+    if ((!requireReady || this.ready) && this.root !== undefined) { return Promise.resolve(this); }
+    return new Promise<WindowSurface>((resolve, reject): void => {
+      let unsubscribe: () => void = (): void => {};
+      const waiter: SurfaceWaiter = {
+        requireReady,
+        resolve: (surface: WindowSurface): void => { unsubscribe(); resolve(surface); },
+        reject: (error: Error): void => { unsubscribe(); reject(error); },
+      };
+      this.waiters.push(waiter);
+      unsubscribe = onCancel((): void => {
+        const index = this.waiters.indexOf(waiter);
+        if (index >= 0) { this.waiters.splice(index, 1); }
+        waiter.reject(new Error("Window surface wait was cancelled"));
+      });
+    });
+  }
+
+  getRootFrameNode(): FrameNode {
+    if (this.root === undefined || this.disposed) { throw new Error("Window mount root is unavailable"); }
+    return this.root;
+  }
+
+  getUIContext(): UIContext {
+    if (this.context === undefined) { throw new Error("Window UIContext is unavailable"); }
+    return this.context;
+  }
+
+  append(key: string, node: FrameNode): void {
+    if (this.root === undefined || this.disposed) { throw new Error("Window surface is unavailable"); }
+    this.remove(key);
+    this.root.appendChild(node);
+    this.nodes.set(key, node);
+  }
+
+  remove(key: string): void {
+    const node = this.nodes.get(key);
+    if (node === undefined) { return; }
+    this.nodes.delete(key);
+    try { this.root?.removeChild(node); } catch {}
+    try { node.dispose(); } catch {}
+  }
+
+  dispose(reason: Error = new Error("Window surface closed before attachment")): void {
+    if (this.disposed) { return; }
+    this.disposed = true;
+    this.failure = reason;
+    for (const waiter of this.waiters.splice(0)) { waiter.reject(reason); }
+    for (const key of Array.from(this.nodes.keys())) { this.remove(key); }
+    this.context = undefined;
+    this.root = undefined;
+  }
+}
+
+/** Bridge-session scoped: a late controller from an old Ability cannot mount in its replacement. */
+export class WindowSurfaceRegistry {
+  private static readonly surfaces: Map<string, WindowSurface> = new Map();
+  private static readonly owners: WeakMap<FrameNode, string> = new WeakMap();
+  private static nextOwner: number = 1;
+
+  static owner(sessionId: string, root: FrameNode): string {
+    let owner = WindowSurfaceRegistry.owners.get(root);
+    if (owner === undefined) {
+      owner = `${sessionId}:surface:${WindowSurfaceRegistry.nextOwner++}`;
+      WindowSurfaceRegistry.owners.set(root, owner);
+    }
+    return owner;
+  }
+
+  static clear(owner: string): void {
+    for (const key of Array.from(WindowSurfaceRegistry.surfaces.keys())) {
+      if (!key.startsWith(`${owner}:window:`)) { continue; }
+      const surface = WindowSurfaceRegistry.surfaces.get(key);
+      WindowSurfaceRegistry.surfaces.delete(key);
+      surface?.dispose();
+    }
+  }
+
+  static key(sessionId: string, windowId: number): string { return `${sessionId}:window:${windowId}`; }
+
+  static get(sessionId: string, windowId: number): WindowSurface {
+    const key = WindowSurfaceRegistry.key(sessionId, windowId);
+    let surface = WindowSurfaceRegistry.surfaces.get(key);
+    if (surface === undefined) {
+      surface = new WindowSurface();
+      WindowSurfaceRegistry.surfaces.set(key, surface);
+    }
+    return surface;
+  }
+
+  static has(key: string): boolean { return WindowSurfaceRegistry.surfaces.has(key); }
+
+  static find(key: string): WindowSurface {
+    const surface = WindowSurfaceRegistry.surfaces.get(key);
+    if (surface === undefined) { throw new Error("Unknown native window surface"); }
+    return surface;
+  }
+
+  static remove(sessionId: string, windowId: number): void {
+    const key = WindowSurfaceRegistry.key(sessionId, windowId);
+    const surface = WindowSurfaceRegistry.surfaces.get(key);
+    WindowSurfaceRegistry.surfaces.delete(key);
+    surface?.dispose();
+  }
+}
+
+class WindowRootController extends NodeController {
+  private root?: FrameNode;
+  makeNode(context: UIContext): FrameNode {
+    if (this.root === undefined) { this.root = new FrameNode(context); }
+    return this.root;
+  }
+  release(): void {
+    try { this.root?.dispose(); } catch {}
+    this.root = undefined;
+  }
+}
+
+@Entry({ routeName: "NativeAbilityWindow", useSharedStorage: true })
+@Component
+struct NativeAbilityWindow {
+  @LocalStorageProp("nativeWindowSurface") surfaceKey: string = "";
+  private controller: WindowRootController = new WindowRootController();
+
+  aboutToAppear(): void {
+    // A queued route can appear after its Ability session has already been disposed.
+    if (!WindowSurfaceRegistry.has(this.surfaceKey)) { return; }
+    const surface = WindowSurfaceRegistry.find(this.surfaceKey);
+    if (surface.isClosed()) { return; }
+    const context = this.getUIContext();
+    surface.attach(context, this.controller.makeNode(context));
+  }
+
+  aboutToDisappear(): void { this.controller.release(); }
+
+  build() {
+    Row() {
+      Column() {
+        NodeContainer(this.controller).width("100%").height("100%")
+      }.width("100%")
+    }.height("100%")
+  }
+}
