+import window from "@ohos.window";
+import deviceInfo from "@ohos.deviceInfo";
+import { ApplicationWindows, BridgeCallContext, BridgePluginContext, BridgeTypedValue, WindowSurfaceRegistry } from "@ohos-rs/ability";
+
+export const MANAGED_REQUEST = "ohos.window.ManagedRequest";
+export const MANAGED_COMMAND = "ohos.window.ManagedCommand";
+
+interface ManagedRequest {
+  windowId: number;
+  title: string;
+  width: number;
+  height: number;
+  x: number;
+  y: number;
+  visible: boolean;
+  decorations: boolean;
+  resizable: boolean;
+  minimizable: boolean;
+  maximizable: boolean;
+  closable: boolean;
+  maximized: boolean;
+}
+
+interface ManagedCommand {
+  windowId: number;
+  operation: string;
+  value?: boolean;
+  text?: string;
+  x?: number;
+  y?: number;
+}
+
+class WindowNotification {
+  windowId: number;
+  kind: string;
+  x: number;
+  y: number;
+  width: number;
+  height: number;
+  scale: number;
+  focused: boolean;
+  visible: boolean;
+  maximized: boolean;
+  minimized: boolean;
+  constructor(windowId: number, kind: string, record?: ManagedRecord) {
+    this.windowId = windowId;
+    this.kind = kind;
+    this.x = record?.rect.left ?? 0;
+    this.y = record?.rect.top ?? 0;
+    this.width = record?.rect.width ?? 0;
+    this.height = record?.rect.height ?? 0;
+    this.scale = record?.scale ?? 1;
+    this.focused = record?.focused ?? false;
+    this.visible = record?.visible ?? false;
+    this.maximized = record?.status === window.WindowStatusType.MAXIMIZE;
+    this.minimized = record?.status === window.WindowStatusType.MINIMIZE;
+  }
+}
+
+class ManagedRecord {
+  readonly win: window.Window;
+  readonly request: ManagedRequest;
+  rect: window.Rect;
+  scale: number;
+  focused: boolean = false;
+  closeAuthorized: boolean = false;
+  visible: boolean;
+  status: window.WindowStatusType;
+  onRect?: (options: window.RectChangeOptions) => void;
+  onEvent?: (event: window.WindowEventType) => void;
+  onStatus?: (status: window.WindowStatusType) => void;
+  onClose?: () => Promise<boolean>;
+  constructor(win: window.Window, request: ManagedRequest) {
+    this.win = win;
+    this.request = request;
+    this.rect = win.getWindowProperties().windowRect;
+    this.scale = win.getUIContext().vp2px(1);
+    this.visible = request.visible;
+    this.status = win.getWindowStatus();
+    this.focused = win.isFocused();
+  }
+}
+
+/** Native windows are owned by a bridge session; logical IDs survive UIContext recreation. */
+export class ManagedWindows {
+  private readonly windows: Map<number, ManagedRecord> = new Map();
+  private readonly creating: Map<number, Promise<void>> = new Map();
+  private generation: number = 0;
+  private disposed: boolean = false;
+  private readonly context: BridgePluginContext;
+  private readonly owner: string;
+  private readonly application?: ApplicationWindows;
+
+  constructor(context: BridgePluginContext) {
+    this.context = context;
+    this.application = ApplicationWindows.find(context.sessionId);
+    this.owner = this.application === undefined ? WindowSurfaceRegistry.owner(context.sessionId, context.getRootFrameNode()) : context.sessionId;
+    this.application?.onClosed((id: number): void => {
+      const record = this.windows.get(id);
+      if (record !== undefined) { this.closed(record); }
+    });
+  }
+
+  async attach(payload: BridgeTypedValue, call: BridgeCallContext): Promise<void> {
+    if (payload.typeName !== MANAGED_REQUEST) { throw new Error("Invalid managed window request type"); }
+    const request = payload.value as ManagedRequest;
+    if (!Number.isSafeInteger(request.windowId) || request.windowId < 0 || request.width <= 0 || request.height <= 0) {
+      throw new Error("Invalid managed window ID or dimensions");
+    }
+    if (this.disposed) { throw new Error("Window host is disposed"); }
+    if (this.windows.has(request.windowId)) { return; }
+    const pending = this.creating.get(request.windowId);
+    if (pending !== undefined) { return await pending; }
+    const generation = this.generation;
+    const promise = this.create(request, call, generation);
+    this.creating.set(request.windowId, promise);
+    try { await promise; } finally { this.creating.delete(request.windowId); }
+  }
+
+  private assertCreationActive(call: BridgeCallContext, generation: number): void {
+    if (this.disposed || generation !== this.generation || !call.isActive()) {
+      throw new Error("Window creation was cancelled");
+    }
+  }
+
+  private async create(request: ManagedRequest, call: BridgeCallContext, generation: number): Promise<void> {
+    const main = request.windowId === 0;
+    const surface = this.application === undefined ? undefined : WindowSurfaceRegistry.get(this.owner, request.windowId);
+    let nativeWindow: window.Window | undefined;
+    let record: ManagedRecord | undefined;
+    try {
+      if (!main && this.application === undefined) { throw new Error("Independent windows require an application Ability host"); }
+      const host = main ? this.application?.get(0) : await this.application!.open(request.windowId, call.onCancel);
+      const win = host?.win ?? this.context.getWindow();
+      nativeWindow = win;
+      this.assertCreationActive(call, generation);
+      if (!main) {
+        await win.resize(request.width, request.height);
+        await win.moveWindowTo(request.x, request.y);
+      }
+      this.assertCreationActive(call, generation);
+      const desktop = deviceInfo.deviceType === "2in1" || deviceInfo.deviceType === "pc";
+      if (desktop) {
+        win.setWindowDecorVisible(request.decorations);
+        await win.setResizeByDragEnabled(request.resizable);
+        await win.setWindowTitle(request.title);
+        win.setWindowTitleButtonVisible(request.maximizable, request.minimizable, request.closable);
+        if (request.maximized) { await win.maximize(window.MaximizePresentation.EXIT_IMMERSIVE); }
+      }
+      this.assertCreationActive(call, generation);
+      record = new ManagedRecord(win, request);
+      this.windows.set(request.windowId, record);
+      this.subscribe(record, desktop);
+      if (request.visible) { await win.showWindow(); }
+      this.assertCreationActive(call, generation);
+      // A mounted ArkUI route is only one step of native creation. WebViews must
+      // not report success before window configuration/show has also succeeded.
+      surface?.markReady();
+      this.notify(record, "resized");
+    } catch (error) {
+      if (record !== undefined) { this.unsubscribe(record); }
+      this.windows.delete(request.windowId);
+      // Keep the failed result until logical-window destruction so a WebView
+      // submitted after this rejection receives the same error, rather than waiting.
+      surface?.dispose(new Error(String(error)));
+      if (!main && nativeWindow !== undefined) {
+        try { await this.application?.close(request.windowId); }
+        catch (failure) { console.error(`Window creation rollback failed: ${String(failure)}`); }
+      }
+      throw new Error(String(error));
+    }
+  }
+
+  private subscribe(record: ManagedRecord, desktop: boolean): void {
+    record.onRect = (options: window.RectChangeOptions): void => {
+      record.rect = options.rect;
+      this.notify(record, "resized");
+    };
+    record.onEvent = (event: window.WindowEventType): void => {
+      if (event === window.WindowEventType.WINDOW_ACTIVE) { record.focused = true; }
+      if (event === window.WindowEventType.WINDOW_INACTIVE) { record.focused = false; }
+      if (event === window.WindowEventType.WINDOW_SHOWN) { record.visible = true; }
+      if (event === window.WindowEventType.WINDOW_HIDDEN) { record.visible = false; }
+      if (event === window.WindowEventType.WINDOW_DESTROYED) { this.closed(record); return; }
+      this.notify(record, "focused");
+    };
+    record.onStatus = (status: window.WindowStatusType): void => {
+      record.status = status;
+      this.notify(record, "state");
+    };
+    record.win.on("windowRectChange", record.onRect);
+    record.win.on("windowEvent", record.onEvent);
+    if (desktop) {
+      record.win.on("windowStatusChange", record.onStatus);
+      record.onClose = async (): Promise<boolean> => {
+        this.notify(record, "close-requested");
+        return true; // Tauri decides whether to cancel or destroy this particular window.
+      };
+      record.win.on("windowWillClose", record.onClose);
+    }
+  }
+
+  private unsubscribe(record: ManagedRecord): void {
+    try { record.win.off("windowRectChange", record.onRect); } catch {}
+    try { record.win.off("windowEvent", record.onEvent); } catch {}
+    if (record.onClose !== undefined) { try { record.win.off("windowWillClose", record.onClose); } catch {} }
+    if (record.onStatus !== undefined) { try { record.win.off("windowStatusChange", record.onStatus); } catch {} }
+  }
+
+  private notify(record: ManagedRecord, kind: string): void {
+    if (this.disposed || this.windows.get(record.request.windowId) !== record) { return; }
+    this.dispatch(new WindowNotification(record.request.windowId, kind, record));
+  }
+
+  private dispatch(notification: WindowNotification): void {
+    if (this.disposed) { return; }
+    try {
+      this.context.invokeNativeSync("window-event", "ohos.window.WindowEvent", "ohos.window.Acknowledgement", notification as ESObject);
+    } catch (error) { console.error(`Native window event failed: ${String(error)}`); }
+  }
+
+  private closed(record: ManagedRecord): void {
+    if (this.windows.get(record.request.windowId) !== record) { return; }
+    // An application UIAbility is a peer logical window. Legacy single-Ability render
+    // recreation still preserves its owner until Tauri explicitly authorizes closure.
+    if (this.application !== undefined || record.closeAuthorized) { this.notify(record, "destroyed"); }
+    this.windows.delete(record.request.windowId);
+    this.unsubscribe(record);
+    WindowSurfaceRegistry.remove(this.owner, record.request.windowId);
+  }
+
+  async update(payload: BridgeTypedValue): Promise<void> {
+    if (payload.typeName !== MANAGED_COMMAND) { throw new Error("Invalid managed window command type"); }
+    const command = payload.value as ManagedCommand;
+    const pending = this.creating.get(command.windowId);
+    if (pending !== undefined) { await pending; }
+    const record = this.windows.get(command.windowId);
+    if (record === undefined && command.operation === "destroy") {
+      WindowSurfaceRegistry.remove(this.owner, command.windowId);
+      return;
+    }
+    if (record === undefined) { throw new Error(`Unknown managed window ${command.windowId}`); }
+    const win = record.win;
+    switch (command.operation) {
+      case "title": await win.setWindowTitle(command.text ?? ""); record.request.title = command.text ?? ""; break;
+      case "resize": await win.resize(command.x!, command.y!); break;
+      case "move": await win.moveWindowTo(command.x!, command.y!); break;
+      case "visible": if (command.value) { await win.showWindow(); } else { await win.minimize(); } break;
+      case "focus":
+        if (this.application !== undefined) { await this.application.focus(command.windowId); }
+        else { await win.showWindow(); }
+        break;
+      case "focusable": await win.setWindowFocusable(command.value!); break;
+      case "minimized":
+        if (command.value) { await win.minimize(); }
+        else if (this.application !== undefined) { await this.application.focus(command.windowId); }
+        else { await win.restore(); }
+        break;
+      case "maximized": if (command.value) { await win.maximize(window.MaximizePresentation.EXIT_IMMERSIVE); } else { await win.recover(); } break;
+      case "decorations": win.setWindowDecorVisible(command.value!); break;
+      case "resizable": await win.setResizeByDragEnabled(command.value!); break;
+      case "topmost": await win.setWindowTopmost(command.value!); break;
+      case "drag": await win.startMoving(); break;
+      case "background": win.setWindowBackgroundColor(command.text!); break;
+      case "destroy":
+        record.closeAuthorized = true;
+        if (this.application !== undefined) { await this.application.close(command.windowId); }
+        else { await win.destroyWindow(); }
+        this.closed(record);
+        return;
+      default: throw new Error(`Unsupported managed window operation '${command.operation}'`);
+    }
+  }
+
+  async dispose(): Promise<void> {
+    this.disposed = true;
+    this.generation += 1;
+    WindowSurfaceRegistry.clear(this.owner);
+    const records = Array.from(this.windows.values());
+    this.windows.clear();
+    for (const record of records) {
+      this.unsubscribe(record);
+      WindowSurfaceRegistry.remove(this.owner, record.request.windowId);
+      // UIAbility lifetime is owned by NativeApplication, not by plugin installation.
+      // Application shutdown terminates its hosts after plugin disposal.
+    }
+  }
+}
