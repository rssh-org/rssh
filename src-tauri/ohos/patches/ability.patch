+use std::{cell::RefCell, collections::HashMap, rc::Rc};
+
+/// OS events carry the logical owner ID, never the platform ID (which may be reused).
+#[derive(Clone, Debug, Default)]
+pub struct WindowEvent {
+    pub window_id: i64,
+    pub kind: String,
+    pub x: i32,
+    pub y: i32,
+    pub width: i32,
+    pub height: i32,
+    pub scale: f64,
+    pub focused: bool,
+    pub visible: bool,
+    pub maximized: bool,
+    pub minimized: bool,
+}
+
+type Callback = Rc<dyn Fn(WindowEvent)>;
+thread_local! {
+    static HANDLERS: RefCell<HashMap<i64, Callback>> = RefCell::new(HashMap::new());
+}
+
+pub fn observe_window(id: i64, callback: impl Fn(WindowEvent) + 'static) {
+    HANDLERS.with(|handlers| handlers.borrow_mut().insert(id, Rc::new(callback)));
+}
+
+pub fn forget_window(id: i64) {
+    HANDLERS.with(|handlers| handlers.borrow_mut().remove(&id));
+}
+
+pub fn dispatch_window_event(event: WindowEvent) {
+    let callback = HANDLERS.with(|handlers| {
+        if event.kind == "destroyed" {
+            handlers.borrow_mut().remove(&event.window_id)
+        } else {
+            handlers.borrow().get(&event.window_id).cloned()
+        }
+    });
+    if let Some(callback) = callback {
+        callback(event);
+    }
+}
+
+pub fn window_context_ready() {
+    // Take a snapshot: callbacks may destroy a window or register a new one.
+    let handlers = HANDLERS.with(|handlers| handlers.borrow().clone());
+    for (id, callback) in handlers {
+        callback(WindowEvent {
+            window_id: id,
+            kind: "ready".into(),
+            ..Default::default()
+        });
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn close_is_scoped_and_context_recreation_keeps_survivors() {
+        let events = Rc::new(RefCell::new(Vec::new()));
+        for id in [7, 8] {
+            let events = events.clone();
+            observe_window(id, move |event| {
+                events.borrow_mut().push((event.window_id, event.kind))
+            });
+        }
+        dispatch_window_event(WindowEvent {
+            window_id: 7,
+            kind: "close-requested".into(),
+            ..Default::default()
+        });
+        dispatch_window_event(WindowEvent {
+            window_id: 7,
+            kind: "destroyed".into(),
+            ..Default::default()
+        });
+        dispatch_window_event(WindowEvent {
+            window_id: 7,
+            kind: "resized".into(),
+            ..Default::default()
+        });
+        window_context_ready();
+        assert_eq!(
+            &*events.borrow(),
+            &[
+                (7, "close-requested".into()),
+                (7, "destroyed".into()),
+                (8, "ready".into())
+            ]
+        );
+        dispatch_window_event(WindowEvent {
+            window_id: 8,
+            kind: "destroyed".into(),
+            ..Default::default()
+        });
+    }
+    #[test]
+    fn callbacks_can_register_another_window_without_reentrant_borrow() {
+        observe_window(1, |_| observe_window(2, |_| {}));
+        dispatch_window_event(WindowEvent {
+            window_id: 1,
+            kind: "close-requested".into(),
+            ..Default::default()
+        });
+        for id in [1, 2] {
+            dispatch_window_event(WindowEvent {
+                window_id: id,
+                kind: "destroyed".into(),
+                ..Default::default()
+            });
+        }
+    }
+}
