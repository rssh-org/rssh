+/// API 11's ArkWeb document-start hook sorts ScriptItems by source text, not insertion
+/// order. Submit one script so framework bootstrap, metadata and plugin setup retain
+/// Wry's order on the API 12 baseline. Keep each script's runtime failures independent.
+pub fn ordered_script(scripts: impl IntoIterator<Item = (String, bool)>) -> String {
+  let mut source = String::new();
+  for (script, main_frame_only) in scripts {
+    source.push_str("try {\n");
+    if main_frame_only {
+      source.push_str("if (window === window.top) {\n");
+    }
+    source.push_str(&script);
+    source.push('\n');
+    if main_frame_only {
+      source.push_str("}\n");
+    }
+    source.push_str("} catch (__wryInitError) { console.error('WebView initialization script failed', __wryInitError); }\n");
+  }
+  source
+}
