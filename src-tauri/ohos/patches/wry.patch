+  #[test]
+  fn operation_failure_is_reported_without_destroying_the_webview() {
+    let (error_tx, error_rx) = mpsc::channel();
+    let (destroy_tx, destroy_rx) = mpsc::channel();
+    let queue = Queue::start(
+      || Ok(()),
