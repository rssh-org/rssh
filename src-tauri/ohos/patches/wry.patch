+//! Ordered WebView work. Only the worker waits for ArkTS; the UI thread never waits for it.
+
+use std::sync::{mpsc, Arc, Mutex};
+
+type Task<T> = Box<dyn FnOnce(&T) -> Result<(), String> + Send>;
+type CreationCallback = Box<dyn FnOnce(Result<(), String>) + Send>;
+
+#[derive(Default)]
+struct State {
+  closed: bool,
+  error: Option<String>,
+  creation: Option<Result<(), String>>,
+  creation_callbacks: Vec<CreationCallback>,
+}
+
+fn complete_creation(state: &Mutex<State>, result: Result<(), String>) {
+  let callbacks = {
+    let mut state = state.lock().unwrap();
+    if state.creation.is_some() {
+      return;
+    }
+    state.creation = Some(result.clone());
+    std::mem::take(&mut state.creation_callbacks)
+  };
+  // Completion may wake application code that immediately closes this queue.
+  for callback in callbacks {
+    callback(result.clone());
+  }
+}
+
+impl State {
+  fn check(&self) -> Result<(), String> {
+    if let Some(error) = &self.error {
+      Err(error.clone())
+    } else if self.closed {
+      Err("WebView has been destroyed".into())
+    } else {
+      Ok(())
+    }
+  }
+}
+
+pub(super) struct Queue<T> {
+  sender: mpsc::Sender<Option<Task<T>>>,
+  state: Arc<Mutex<State>>,
+}
+
+impl<T: 'static> Queue<T> {
+  pub fn start(
+    create: impl FnOnce() -> Result<T, String> + Send + 'static,
+    destroy: impl FnOnce(T) -> Result<(), String> + Send + 'static,
+    report: impl Fn(String, bool) + Send + 'static,
+  ) -> Result<Self, String> {
+    let (sender, receiver) = mpsc::channel::<Option<Task<T>>>();
+    let state = Arc::new(Mutex::new(State::default()));
+    let worker_state = state.clone();
+    std::thread::Builder::new()
+      .name("wry-ohos-webview".into())
+      .spawn(move || {
+        let fail = |error: String| {
+          worker_state.lock().unwrap().error = Some(error.clone());
+          complete_creation(&worker_state, Err(error.clone()));
+          report(error, true);
+        };
+        let controller = match create() {
+          Ok(controller) => controller,
+          Err(error) => {
+            fail(error);
+            return;
+          }
+        };
+        let created = worker_state.lock().unwrap().check();
+        complete_creation(&worker_state, created);
+        while worker_state.lock().unwrap().check().is_ok() {
+          let Ok(Some(task)) = receiver.recv() else {
+            break;
+          };
+          if worker_state.lock().unwrap().check().is_err() {
+            break;
+          }
+          if let Err(error) = task(&controller) {
+            report(error, false);
+          }
+        }
+        if let Err(error) = destroy(controller) {
+          report(error, false);
+        }
+      })
+      .map_err(|error| error.to_string())?;
+    Ok(Self { sender, state })
+  }
+
+  pub fn check(&self) -> Result<(), String> {
+    self.state.lock().unwrap().check()
+  }
+
+  pub fn on_created(&self, callback: impl FnOnce(Result<(), String>) + Send + 'static) {
+    let result = {
+      let mut state = self.state.lock().unwrap();
+      match &state.creation {
+        Some(result) => result.clone(),
+        None => {
+          state.creation_callbacks.push(Box::new(callback));
+          return;
+        }
+      }
+    };
+    callback(result);
+  }
+
+  pub fn send(
+    &self,
+    task: impl FnOnce(&T) -> Result<(), String> + Send + 'static,
+  ) -> Result<(), String> {
+    self.check()?;
+    self.sender.send(Some(Box::new(task))).map_err(|_| {
+      self
+        .check()
+        .err()
+        .unwrap_or_else(|| "WebView worker is unavailable".into())
+    })
+  }
+}
+
+impl<T> Drop for Queue<T> {
+  fn drop(&mut self) {
+    self.state.lock().unwrap().closed = true;
+    complete_creation(&self.state, Err("WebView has been destroyed".into()));
+    // Wake an idle worker; a pending create is disposed as soon as it completes.
+    let _ = self.sender.send(None);
+  }
+}
+
+#[cfg(test)]
+mod tests {
+  use super::Queue;
+  use std::sync::mpsc;
+
+  #[test]
+  fn creation_callbacks_wait_and_retain_the_exact_failure_for_late_observers() {
+    let (create_tx, create_rx) = mpsc::channel();
+    let (result_tx, result_rx) = mpsc::channel();
+    let queue = Queue::<()>::start(
+      move || {
+        create_rx.recv().unwrap();
+        Err("native window limit".into())
+      },
+      |_| panic!("failed creation has no controller"),
+      |_, _| {},
+    )
+    .unwrap();
+    let first = result_tx.clone();
+    queue.on_created(move |result| first.send(result).unwrap());
+    assert!(result_rx.try_recv().is_err());
+    create_tx.send(()).unwrap();
+    assert_eq!(result_rx.recv().unwrap(), Err("native window limit".into()));
+    queue.on_created(move |result| result_tx.send(result).unwrap());
+    assert_eq!(result_rx.recv().unwrap(), Err("native window limit".into()));
+  }
+
+  #[test]
+  fn closing_during_creation_settles_observers_without_waiting_for_native_completion() {
+    let (create_tx, create_rx) = mpsc::channel();
+    let (result_tx, result_rx) = mpsc::channel();
+    let (destroy_tx, destroy_rx) = mpsc::channel();
+    let queue = Queue::start(
+      move || create_rx.recv().map_err(|e| e.to_string()),
+      move |()| {
+        destroy_tx.send(()).unwrap();
+        Ok(())
+      },
+      |_, _| {},
+    )
+    .unwrap();
+    queue.on_created(move |result| result_tx.send(result).unwrap());
+    drop(queue);
+    assert_eq!(
+      result_rx.recv().unwrap(),
+      Err("WebView has been destroyed".into())
+    );
+    create_tx.send(()).unwrap();
+    destroy_rx.recv().unwrap();
+  }
+
+  #[test]
+  fn creation_callbacks_report_success_before_queued_work() {
+    let (create_tx, create_rx) = mpsc::channel();
+    let (event_tx, event_rx) = mpsc::channel();
+    let queue = Queue::start(
+      move || create_rx.recv().map_err(|e| e.to_string()),
+      |()| Ok(()),
+      |_, _| {},
+    )
+    .unwrap();
+    let ready = event_tx.clone();
+    queue.on_created(move |result| {
+      assert_eq!(result, Ok(()));
+      ready.send("ready").unwrap();
+    });
+    queue
+      .send(move |()| {
+        event_tx.send("task").unwrap();
+        Ok(())
+      })
+      .unwrap();
+    create_tx.send(()).unwrap();
+    assert_eq!(event_rx.recv().unwrap(), "ready");
+    assert_eq!(event_rx.recv().unwrap(), "task");
+  }
+
+  #[test]
+  fn operations_wait_for_creation_and_keep_submission_order() {
+    let (create_tx, create_rx) = mpsc::channel();
+    let (event_tx, event_rx) = mpsc::channel();
+    let destroyed = event_tx.clone();
+    let queue = Queue::start(
+      move || create_rx.recv().map_err(|error| error.to_string()),
+      move |()| destroyed.send(3).map_err(|error| error.to_string()),
+      |error, _| panic!("unexpected error: {error}"),
+    )
+    .unwrap();
+    for value in [1, 2] {
+      let tx = event_tx.clone();
+      queue
+        .send(move |()| tx.send(value).map_err(|error| error.to_string()))
+        .unwrap();
+    }
+    assert!(event_rx.try_recv().is_err());
+    create_tx.send(()).unwrap();
+    assert_eq!(event_rx.recv().unwrap(), 1);
+    assert_eq!(event_rx.recv().unwrap(), 2);
+    drop(queue);
+    assert_eq!(event_rx.recv().unwrap(), 3);
+  }
+
+  #[test]
+  fn creation_failure_is_retained_and_pending_operations_are_dropped() {
+    let (create_tx, create_rx) = mpsc::channel();
+    let (error_tx, error_rx) = mpsc::channel();
+    let queue = Queue::<()>::start(
+      move || {
+        create_rx.recv().unwrap();
+        Err("create rejected".into())
+      },
+      |_| panic!("failed creation must not be destroyed twice"),
+      move |error, _| error_tx.send(error).unwrap(),
+    )
+    .unwrap();
+    queue
+      .send(|_| panic!("must not run before successful creation"))
+      .unwrap();
+    create_tx.send(()).unwrap();
+    assert_eq!(error_rx.recv().unwrap(), "create rejected");
+    assert_eq!(queue.check().unwrap_err(), "create rejected");
+    assert_eq!(queue.send(|_| Ok(())).unwrap_err(), "create rejected");
+  }
+
+  #[test]
+  fn destroying_during_creation_discards_work_and_removes_the_late_controller() {
+    let (create_tx, create_rx) = mpsc::channel();
+    let (destroy_tx, destroy_rx) = mpsc::channel();
+    let queue = Queue::start(
+      move || create_rx.recv().map_err(|error| error.to_string()),
+      move |value| destroy_tx.send(value).map_err(|error| error.to_string()),
+      |error, _| panic!("unexpected error: {error}"),
+    )
+    .unwrap();
+    queue
+      .send(|_| panic!("destroyed WebView must not execute pending work"))
+      .unwrap();
+    drop(queue);
+    create_tx.send(42).unwrap();
