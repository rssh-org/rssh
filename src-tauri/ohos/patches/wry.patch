+    let (create_tx, create_rx) = mpsc::channel();
+    let (removed_tx, removed_rx) = mpsc::channel();
+    let old_removed = removed_tx.clone();
+    let old = Queue::start(
+      move || create_rx.recv().map_err(|error| error.to_string()),
+      move |id| old_removed.send(id).map_err(|error| error.to_string()),
+      |error, _| panic!("unexpected error: {error}"),
