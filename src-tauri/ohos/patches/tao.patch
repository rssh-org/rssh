+use openharmony_ability::OpenHarmonyApp;
+use openharmony_ability_plugin_window::{
+  observe_window, ManagedWindowCommand, ManagedWindowRequest, WindowEvent, WindowExt,
+};
+use std::sync::{
+  atomic::{AtomicBool, Ordering},
+  mpsc, Arc, Mutex,
+};
+
+pub struct WindowState {
+  pub request: ManagedWindowRequest,
+  pub scale: f64,
+  pub focused: bool,
+  pub minimized: bool,
+  pub topmost: bool,
+}
+
+impl WindowState {
+  pub fn new(request: ManagedWindowRequest, scale: f64) -> Self {
+    Self {
+      request,
+      scale,
+      focused: false,
+      minimized: false,
+      topmost: false,
+    }
+  }
+
+  fn update(&mut self, event: &WindowEvent) {
+    self.request.x = event.x;
+    self.request.y = event.y;
+    self.request.width = event.width;
+    self.request.height = event.height;
+    self.request.visible = event.visible;
+    self.request.maximized = event.maximized;
+    self.focused = event.focused;
+    self.minimized = event.minimized;
+    if event.scale > 0.0 {
+      self.scale = event.scale;
+    }
+  }
+
+  fn applied(&mut self, command: &ManagedWindowCommand) {
+    match command.operation.as_str() {
+      "title" => self.request.title = command.text.clone().unwrap_or_default(),
+      "decorations" => self.request.decorations = command.value.unwrap_or(true),
+      "resizable" => self.request.resizable = command.value.unwrap_or(true),
+      "topmost" => self.topmost = command.value.unwrap_or(false),
+      _ => {}
+    }
+  }
+}
+
+enum Operation {
+  Attach,
+  Update(ManagedWindowCommand),
+  Destroy,
+}
+
+/// Serial OS operations execute outside the N-API thread. The queue owns native-window
+/// lifetime; asynchronous creation and a following destroy cannot overtake each other.
+pub struct WindowQueue {
+  sender: mpsc::Sender<Operation>,
+  alive: Arc<AtomicBool>,
+  main_closed: Arc<AtomicBool>,
+  main: bool,
+}
+
+impl WindowQueue {
+  pub fn start(
+    app: OpenHarmonyApp,
+    state: Arc<Mutex<WindowState>>,
+    events: mpsc::Sender<WindowEvent>,
+    main_closed: Arc<AtomicBool>,
+  ) -> std::io::Result<Self> {
+    let (sender, receiver) = mpsc::channel();
+    let alive = Arc::new(AtomicBool::new(true));
+    let id = state.lock().unwrap().request.window_id;
+    let waker = app.create_waker();
+    let worker_state = state.clone();
+    let worker_events = events.clone();
+    let worker_waker = waker.clone();
+    let worker_main_closed = main_closed.clone();
+    std::thread::Builder::new()
+      .name(format!("tao-window-{id}"))
+      .spawn(move || {
+        while let Ok(operation) = receiver.recv() {
+          let operation = if id != 0 && worker_main_closed.load(Ordering::Acquire) {
+            Operation::Destroy
+          } else {
+            operation
+          };
+          let mut destroyed = matches!(operation, Operation::Destroy);
+          let result = (|| {
+            // The facade belongs to the current Ability session. Do not retain it across reloads.
+            let client = app.window()?;
+            match operation {
+              Operation::Attach => {
+                let request = worker_state.lock().unwrap().request.clone();
+                futures_executor::block_on(client.attach_managed_window(request))
+              }
+              Operation::Update(command) => {
+                futures_executor::block_on(client.update_managed_window(command.clone()))?;
+                worker_state.lock().unwrap().applied(&command);
+                Ok(())
+              }
+              Operation::Destroy => {
+                futures_executor::block_on(client.update_managed_window(ManagedWindowCommand {
+                  window_id: id,
+                  operation: "destroy".into(),
+                  value: None,
+                  text: None,
+                  x: None,
+                  y: None,
+                }))
+              }
+            }
+          })();
+          if let Err(error) = result {
+            log::error!("OpenHarmony window {id}: {error}");
+          }
+          if !destroyed && id != 0 && worker_main_closed.load(Ordering::Acquire) {
+            // The main window can close while this child's attach is in flight.
+            // Always finish its logical owner, including a failed/cancelled attach.
+            if let Ok(client) = app.window() {
+              let _ =
+                futures_executor::block_on(client.update_managed_window(ManagedWindowCommand {
+                  window_id: id,
+                  operation: "destroy".into(),
+                  value: None,
+                  text: None,
+                  x: None,
+                  y: None,
+                }));
+            }
+            destroyed = true;
+          }
+          if destroyed {
+            // Complete Tauri ownership cleanup even if the OS already destroyed the window.
+            let _ = worker_events.send(WindowEvent {
+              window_id: id,
+              kind: "destroyed".into(),
+              ..Default::default()
+            });
+            worker_waker.wake();
+            break;
+          }
+        }
+      })?;
+    let callback_sender = sender.clone();
+    let callback_alive = alive.clone();
+    observe_window(id, move |event| {
+      if event.kind == "ready" {
+        if callback_alive.load(Ordering::Acquire) {
+          let _ = callback_sender.send(Operation::Attach);
+        }
+        return;
+      }
+      if event.kind != "destroyed" {
+        state.lock().unwrap().update(&event);
+      }
+      let _ = events.send(event);
+      waker.wake();
+    });
+    let _ = sender.send(Operation::Attach);
+    Ok(Self {
+      sender,
+      alive,
+      main_closed,
+      main: id == 0,
+    })
+  }
+
+  pub fn send(&self, command: ManagedWindowCommand) {
+    if self.sender.send(Operation::Update(command)).is_err() {
+      log::error!("Native window queue is closed");
+    }
+  }
+}
+
+impl Drop for WindowQueue {
+  fn drop(&mut self) {
+    if self.main {
+      self.main_closed.store(true, Ordering::Release);
+    }
+    self.alive.store(false, Ordering::Release);
+    let _ = self.sender.send(Operation::Destroy);
+  }
+}
