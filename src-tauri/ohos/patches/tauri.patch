+// These operations are also available to HarmonyOS PC windows. Keep desktop-only
+// integrations (taskbar, cursor, effects) in their own platform-gated command group.
+#[cfg(any(desktop, target_env = "ohos"))]
+mod window_management_commands {
+  use super::*;
+  use crate::command;
+
+  getter!(is_minimized, bool);
+  getter!(is_maximized, bool);
+  getter!(is_decorated, bool);
+  getter!(is_maximizable, bool);
+  getter!(is_minimizable, bool);
+  getter!(is_closable, bool);
+  getter!(is_always_on_top, bool);
+  setter!(maximize);
+  setter!(unmaximize);
+  setter!(minimize);
+  setter!(unminimize);
+  setter!(set_decorations, bool);
+  setter!(set_always_on_top, bool);
+  setter!(start_dragging);
+
+  #[command(root = "crate")]
+  pub async fn toggle_maximize<R: Runtime>(
+    window: Window<R>,
+    label: Option<String>,
+  ) -> crate::Result<()> {
+    let window = get_window(window, label)?;
+    if window.is_maximized()? {
+      window.unmaximize()?
+    } else {
+      window.maximize()?
+    };
+    Ok(())
+  }
+
+  #[command(root = "crate")]
+  pub async fn internal_toggle_maximize<R: Runtime>(
+    window: Window<R>,
+    label: Option<String>,
+  ) -> crate::Result<()> {
+    let window = get_window(window, label)?;
+    if window.is_resizable()? {
+      if window.is_maximized()? {
+        window.unmaximize()?
+      } else if window.is_maximizable()? {
+        window.maximize()?
+      };
+    }
+    Ok(())
+  }
+}
