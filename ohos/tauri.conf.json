{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RSSH",
  "version": "0.0.1",
  "identifier": "com.rssh.app",
  "build": {
    "frontendDist": "../target/ohos-frontend"
  },
  "app": {
    "windows": [
      {
        "title": "RSSH",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "../icons/32x32.png",
      "../icons/128x128.png",
      "../icons/128x128@2x.png",
      "../icons/icon.icns",
      "../icons/icon.ico"
    ]
  }
}
